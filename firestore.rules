rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Documento definitivo: appData/{uid}
    match /appData/{userId} {
      allow read: if request.auth != null
                  && userId == request.auth.uid
                  && resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
                    && userId == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;

      allow update: if request.auth != null
                    && userId == request.auth.uid
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if request.auth != null
                    && userId == request.auth.uid
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Compatibilidad temporal para migrar instalaciones anteriores que usaban
    // appData/aquariumFish. Una vez migrados los datos, este bloque puede
    // eliminarse para dejar el acceso completamente cerrado.
    match /appData/aquariumFish {
      allow read: if request.auth != null
                  && (!resource.data.ownerUid || resource.data.ownerUid == request.auth.uid);

      allow create, update: if request.auth != null
                            && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if request.auth != null
                    && (!resource.data.ownerUid || resource.data.ownerUid == request.auth.uid);
    }
  }
}
